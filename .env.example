# Anthropic API key — required by the LLM proxy server (server/proxy.ts).
# Get one at https://console.anthropic.com/. Never commit a real key.
ANTHROPIC_API_KEY=

# URL of the LLM proxy endpoint, consumed by the client.
# Default: same-origin /api/chat (works with the dev proxy and Docker compose).
VITE_API_ENDPOINT=/api/chat
